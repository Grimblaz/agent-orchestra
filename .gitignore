.copilot-tracking/
.copilot-tracking-archive/
.tmp/
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/hooks/**
.claude/.state/
memory/
plan-issue-*.md
pester-*.txt
testResults.xml
